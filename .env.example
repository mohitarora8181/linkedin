PORT=3000
PUBLIC_WEB_URL=https://linkerin.toopsy.app
LINKERIN_IMAGE=your-dockerhub-username/linkerin:latest

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=linkerin
MYSQL_USER=linkerin_user
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_SSL=false

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_OAUTH_SUCCESS_URL=linkerin://auth/callback
JWT_SECRET=replace-with-a-long-random-secret

RABBITMQ_URL=
RABBITMQ_EXCHANGE=linkerin.scrape
RABBITMQ_QUEUE=linkerin.scrape.jobs
RABBITMQ_AI_QUEUE=groq_ai_parsing
RABBITMQ_GMAIL_QUEUE=linkerin.gmail.send
RABBITMQ_BULK_EMAIL_QUEUE=bulk_email_processor
ENABLE_GMAIL_WORKER=true
ENABLE_BULK_EMAIL_WORKER=true
GEMINI_API_KEY=
GROQ_API_KEY=
